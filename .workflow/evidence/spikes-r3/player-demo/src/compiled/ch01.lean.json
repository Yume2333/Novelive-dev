     "step": 48
    },
    {
     "type": "line",
     "kind": "inner",
     "speaker": "xiangzi",
     "alias": null,
     "inner": true,
     "text": "今年二十二岁。生日早忘了——今天买上新车，就算生日吧！",
     "segs": [
      {
       "text": "今年二十二岁。生日早忘了——今天买上新车，就算生日吧！",
