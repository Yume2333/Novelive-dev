     "step": 46
    },
    {
     "type": "line",
     "kind": "narration",
     "text": "揣起保单，拉起车，祥子几乎要哭出来。",
     "segs": [
      {
       "text": "揣起保单，拉起车，祥子几乎要哭出来。",
