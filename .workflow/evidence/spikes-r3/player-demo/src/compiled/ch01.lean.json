     "cont": false,
     "line": 73,
     "step": 49
    },
    {
     "type": "line",
     "kind": "inner",
     "speaker": "xiangzi",
     "alias": null,
     "inner": true,
     "text": "人的也是车的，好记。",
     "segs": [
      {
       "text": "人的也是车的，好记。",
       "marks": [],
       "speed": 1
      }
