{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": false, "skipLibCheck": true,
    "isolatedModules": true, "noEmit": true, "allowImportingTsExtensions": false,
    "resolveJsonModule": true, "useDefineForClassFields": true,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
