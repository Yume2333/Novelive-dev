{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": [
		"apps/**/*.ts",
		"packages/**/*.ts",
		"packages/**/*.tsx",
		"tools/**/*.ts",
		"tests/**/*.ts",
		"*.config.ts"
	]
}
